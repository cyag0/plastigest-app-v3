# Backend API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_API_TIMEOUT=10000

# Environment
EXPO_PUBLIC_APP_ENV=development

# App Configuration
EXPO_PUBLIC_APP_NAME=PlastiGest
EXPO_PUBLIC_APP_VERSION=1.0.0

# Firebase Web Push Configuration
# Firebase Console > Project settings > General > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Storage Keys (opcional, para consistencia)
EXPO_PUBLIC_AUTH_TOKEN_KEY=auth_token
EXPO_PUBLIC_USER_DATA_KEY=user_data

# Debug Configuration
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_REQUESTS=true