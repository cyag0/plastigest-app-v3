# Copia este archivo como .env en desarrollo (.env) o configúralo en
# eas.json/env.production en build de producción.

# Backend API
# Desarrollo local con Sail: http://localhost/api
# Producción: https://api.tu-dominio.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_API_TIMEOUT=10000

# Environment
EXPO_PUBLIC_APP_ENV=development

# App
EXPO_PUBLIC_APP_NAME=PlastiGest
EXPO_PUBLIC_APP_VERSION=1.0.0

# Firebase Web Push — desde Firebase Console > Project Settings
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# VAPID key para web push
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Storage keys
EXPO_PUBLIC_AUTH_TOKEN_KEY=auth_token
EXPO_PUBLIC_USER_DATA_KEY=user_data

# Debug
# IMPORTANTE: dejar en false en builds de producción
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_REQUESTS=false
